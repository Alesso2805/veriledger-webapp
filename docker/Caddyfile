# Serves the built app (ADR-0003). The API sits behind the front Caddy at /api, not in this container.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip

	# connect-src is 'self' because the API shares the origin; CSP_CONNECT_SRC adds an API on another origin.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self' {$CSP_CONNECT_SRC}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	# Vite puts a content hash in every file name under /assets, so those can be cached for good.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@unhashed not path /assets/*
	header @unhashed Cache-Control "no-store"

	# Unknown paths answer index.html, so client routes such as /wallet survive a reload.
	try_files {path} /index.html
	file_server
}
